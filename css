style.css
.trust-platforms {
  padding: 60px 20px;
  background: #0f0f0f;
  color: #ffffff;
  text-align: center;
}

.trust-platforms h2 {
  font-size: 32px;
  margin-bottom: 10px;
}

.subtitle {
  color: #b3b3b3;
  margin-bottom: 40px;
}

.platform-grid {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.platform-card {
  background: #1a1a1a;
  padding: 20px;
  border-radius: 12px;
  width: 280px;
  text-align: left;
}

.platform-card h3 {
  margin-bottom: 10px;
}

.tag {
  display: inline-block;
  margin-top: 10px;
  padding: 5px 10px;
  background: #00c853;
  color: #000;
  font-size: 12px;
  border-radius: 6px;
}
